{{!
    @template core/filemanager_infofile

    This template renders an info popup dialogue window with an OK button only, shown when a
    previously-used filename is re-uploaded (e.g. after deletion) to inform the user it will
    be renamed to prevent browser caching.

    Example context (json):
    {}
}}
<div class="file-picker fp-dlg">
    <p class="fp-dlg-text"></p>
    <div class="fp-dlg-buttons">
        <button class="fp-dlg-butok btn btn-primary mb-1">{{#str}}ok{{/str}}</button>
    </div>
</div>
