{{!
    @template core/login_panel

    Default content for the left panel of the split-screen login layout.

    Displays a welcome heading, description, community tagline, and
    placeholder stats. Themes can override this partial to provide
    custom branding or dynamic content.

    Example context (json):
    {}
}}
<div class="login-layout-left-content">
    <div class="login-layout-title mb-3 text-start">{{#str}}loginwelcometitle{{/str}}</div>
    <div class="login-layout-description mb-4 text-start">
        {{#instructions}}
            {{{instructions}}}
        {{/instructions}}
    </div>
    <p class="login-layout-tagline mb-4">{{#str}}loginpaneltagline{{/str}}</p>
    <div class="login-layout-stats" role="presentation">
        <div class="login-layout-stat">
            <strong class="login-layout-stat-value">500M</strong>
            <span class="login-layout-stat-label">{{#str}}loginstatusers{{/str}}</span>
        </div>
        <div class="login-layout-stat">
            <strong class="login-layout-stat-value">150K</strong>
            <span class="login-layout-stat-label">{{#str}}loginstatsites{{/str}}</span>
        </div>
        <div class="login-layout-stat">
            <strong class="login-layout-stat-value">200+</strong>
            <span class="login-layout-stat-label">{{#str}}loginstatcountries{{/str}}</span>
        </div>
    </div>
</div>
