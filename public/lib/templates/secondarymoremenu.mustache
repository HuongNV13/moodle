{{!
    @template core/secondarymoremenu

    React-rendered secondary navigation tab bar (course/module/category/admin).

    Mounts @moodle/lms/core/nav/SecondaryNav via the react mustache helper. This partial is only
    used where $PAGE->secondarynav is rendered (theme_boost columns2/drawers layouts); the
    primary/drawer top-nav "more menu" still uses the legacy core/moremenu partial.

    Example context (json):
    {
        "reactprops": "{\"items\":[{\"key\":\"coursehome\",\"text\":\"Course\",\"href\":\"https://example.com\",\"active\":true,\"forceintomoremenu\":false,\"showchildreninsubmenu\":false,\"children\":[]}],\"morelabel\":\"More\",\"istablist\":true}"
    }
}}
{{#reactprops}}
{{#react}}
{
    "component": "@moodle/lms/core/nav/SecondaryNav",
    "class": "secondarynav-react navigation",
    "props": {{{reactprops}}}
}
{{/react}}
{{/reactprops}}
